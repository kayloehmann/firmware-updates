{
	"$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**/*.{js,ts,mjs,cjs,mts,cts}",
			"**/*.json",
			"**/*.md",
			"biome.json",
			"!!build",
			"!!cache",
			"!!.yarn",
			"!!.github/workflows",
			"!CHANGELOG*.md",
			"!**/package.json",
			"!firmwares/**",
			"!**/package-lock.json",
			"!**/*.min.js",
			"!docs/marked.min.js"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 80
	},
	"json": {
		"parser": {
			"allowComments": true,
			"allowTrailingCommas": true
		},
		"formatter": {
			"trailingCommas": "none"
		}
	},
	"markdown": {
		"formatter": {
			"enabled": true
		}
	},
	"linter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	}
}
